{
  // For more information, visit: https://go.microsoft.com/fwlink/?LinkId=733558
  "version": "2.0.0",
  "tasks": [
    {
      "label": "serve-angular",
      "type": "shell",
      "command": "npm start -- --port 4201",
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "angular",
          "pattern": {
            "regexp": ".*",
            "file": 1,
            "location": 1,
            "message": 0
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*",
            "endsPattern": "Local:\\s+http://localhost:4201/"
          }
        }
      ]
    },
    {
      "type": "npm",
      "script": "test",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    }
  ]
}
