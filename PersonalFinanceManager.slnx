<Solution>
  <!-- The layered architecture: WebApi (runs) references DAL, Utils, and DataModels. -->
  <!-- Open this solution in Visual Studio and press F5 to run FinanceTracker.WebApi. -->
  <Project Path="FinanceTracker.WebApi/FinanceTracker.WebApi.csproj" />       <!-- The running Web API. -->
  <Project Path="FinanceTracker.DAL/FinanceTracker.DAL.csproj" />             <!-- Data access layer. -->
  <Project Path="FinanceTracker.DataModels/FinanceTracker.DataModels.csproj" /> <!-- Shared models. -->
  <Project Path="FinanceTracker.Utils/FinanceTracker.Utils.csproj" />         <!-- Hashing + JWT helpers. -->
</Solution>
