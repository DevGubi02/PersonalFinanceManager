<!-- This is the WEB API project — the only project that runs as a web server. -->
<!-- It holds controllers + business logic and references the DAL, Utils, and DataModels. -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>   <!-- Build for .NET 10. -->
    <Nullable>enable</Nullable>                  <!-- Turn on null-safety checks. -->
    <ImplicitUsings>enable</ImplicitUsings>      <!-- Auto-import common namespaces. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />            <!-- Swagger/OpenAPI. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" /> <!-- JWT auth. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" /> <!-- SQL Server + DbContext. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.9">        <!-- EF tooling. -->
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Reference our three supporting projects so the Web API can use their classes. -->
    <ProjectReference Include="..\FinanceTracker.DAL\FinanceTracker.DAL.csproj" />               <!-- Data access. -->
    <ProjectReference Include="..\FinanceTracker.Utils\FinanceTracker.Utils.csproj" />           <!-- Hashing + JWT. -->
    <ProjectReference Include="..\FinanceTracker.DataModels\FinanceTracker.DataModels.csproj" /> <!-- Shared models. -->
  </ItemGroup>

</Project>
